@{
	ViewData["Title"] = "Policy";
}
<section class="podium-section">
	<div class="podium-ref-div">
		<div class="product-commerce-cards">
		</div>
	</div>
</section>
<section class="third-section container podium-section contact-us">
	<div class="section-content">
		<!-- Heading -->
		<div class="section-heading">
			<h2 class="pb-4 text-uppercase">Chính sách vận chuyển</h2>

			<div class="text-white" style="letter-spacing:2px;">
				<h5>PHƯƠNG THỨC  VẬN CHUYỂN HỎA TỐC</h5>
				<ul>
					<li>
						Phạm vi áp dụng: khu vực Nội thành Thành phố Hồ Chí Minh
					</li>
					<li>
						Thanh toán: chuyển khoản trước 100% giá trị đơn hàng
					</li>
					<li>
						Phí ship đồng giá: 35k/ đơn hàng
					</li>
					<li>
						Cách đặt hàng: đặt hàng qua fanpage/ zalo
					</li>
					<li>
						Giảm trực tiếp 5% giá trị đơn hàng đối với khách đặt qua hình thức này
					</li>
				</ul>
				<br />
				<h5>PHƯƠNG THỨC VẬN CHUYỂN THƯỜNG</h5>
				<p>Áp dụng với đơn hàng toàn quốc:</p>
				<ul class="g-4">
					<li class="pb-2">
						Thanh toán COD (nhận hàng và thanh toán với shipper của đơn vị vận chuyển).<strong> NẾU quý khách có nhu cầu thanh toán chuyển khoản trước, vui lòng liên hệ trực tiếp với chúng tôi qua Fanpage để được hỗ trợ.</strong>

					</li>
					<li class="pb-2">
						<p>Vận chuyển bởi đơn vị Viettel Post. Thông tin chi phí và thời gian kho vận như sau:</p>
						<strong>Khu vực Nội thành Thành phố Hồ Chí Minh:</strong>
						<ul>
							<li>
								Miễn phí vận chuyển nội thành cho các đơn hàng trị giá từ 300.000đ trở lên.
							</li>
							<li>
								Các đơn hàng dưới 300.000đ Quý khách chỉ mất 10.000đ phí vận chuyển.
							</li>
							<li>
								Thời gian giao nhận trung bình* 2-3 ngày kể từ ngày người bán gửi hàng. (Không tính thứ bảy, chủ nhật và ngày lễ).
							</li>
						</ul>

						<strong>Khu vực các tỉnh/ thành phố khác:</strong><br />
						<ul>
							<li>
								Miễn phí vận chuyển đối với đơn hàng từ 500.000đ trở lên.
							</li>
							<li>
								Đơn hàng dưới 500.000đ có cước phí vận chuyển là 25.000đ
							</li>
							<li>
								Thời gian giao nhận trung bình* 2-4 ngày kể từ ngày người bán gửi hàng. (Không tính thứ bảy, chủ nhật và ngày lễ)
							</li>
						</ul>
					</li>
				</ul>

				<p><strong>LƯU Ý:</strong></p>
				<ul>
					<li>
						Thời gian giao nhận trung bình là ước lượng. Thời gian giao nhận thực tế có chênh lệch tùy vào tình trạng điều phối, kho vận của đơn vị vận chuyển và lưu lượng đơn hàng tại thời điểm đó. Nếu có bất kỳ tình huống phát sinh nào, mong quý khách vui lòng liên hệ với chúng tôi để được xử lý kịp thời.
					</li>
					<li>
						Tất cả đơn hàng được đặt trên website đều sẽ được liên hệ <strong>xác nhận qua điện thoại trước khi giao.</strong>Đơn sẽ được tiến hành đóng gói và gửi đi sau khi hoàn tất xác nhận qua điện thoại. Trong trường hợp không liên hệ được với quý khách 3 lần, đơn hàng sẽ bị tự động hủy bởi hệ thống.
					</li>
					<li>
						Khi nhận hàng, quý khách vui lòng quay phim lại toàn bộ quá trình mở hàng để dễ dàng đối chiếu với đơn vị vận chuyển nếu có bất kỳ tình huống nào phát sinh.
					</li>
				</ul>
			</div>
		</div>
	</div>
	<div class="section-content">
		<!-- Heading -->
		<div class="section-heading">
			<h2 class="pb-4 text-uppercase">Chính sách hoàn trả sản phẩm</h2>
			<p>
				DOUCÉ có chế độ 1 hoàn 1 trong vòng 10 ngày từ ngày mua hàng do lỗi từ nhà sản xuất hoặc đơn vị bán hàng với chính sách cụ thể như sau:
			</p>
			<p><strong>Điều kiện hoàn trả</strong></p>
			<div class="text-white" style="letter-spacing:2px;">
				<h5>1. Các trường hợp sản phẩm được hoàn trả:</h5>
				<div class="mb-4 p-2">
					<span>
						- Sản phẩm mắc lỗi từ phía nhà sản xuất (hư hỏng, đổ vỡ sản phẩm, bị lỗi kỹ thuật, …)
					</span><br />
					<span>
						- Sản phẩm bị hư hỏng do quá trình vận chuyển của đơn vị vận chuyển
					</span><br />
					<span>
						- Sản phẩm đã hết thời hạn sử dụng
					</span><br />
					<span>
						- Sản phẩm không đúng như yêu cầu đặt hàng của khách hàng
					</span><br />
				</div>
				<h5>2. Yêu cầu đối với sản phẩm được hoàn trả:</h5>
				<div class="mb-4 p-2">
					<span>
						- Sản phẩm phải còn nguyên vỏ hộp, các phụ kiện đi kèm, tem nhãn và chưa qua sử dụng
					</span><br />
					<span>
						- Cung cấp đầy đủ email/ hóa đơn mua hàng.
					</span><br />
					<span>
						- Cung cấp video ghi hình mở kiện hàng.
					</span><br />

				</div>
				<h5>3. Các trường hợp không chấp nhận hoàn trả:</h5>
				<div class="mb-4 p-2">
					<span>
						- Sản phẩm đã quá hạn hoàn trả
					</span><br />
					<span>
						- Sản phẩm đã bị bóc tem nhãn, seal,
					</span><br />
					<span>
						- Sản phẩm khách đã qua sử dụng,
					</span><br />
					<span>
						- Các hư hỏng từ Bao bì, phụ kiện, vỏ hộp bị hư hỏng, trầy xước do lỗi từ phía khách hàng.
					</span><br />
				</div>
				<h5>4. Cách thức hoàn trả sản phẩm:</h5>
				<div class="mb-4 p-2">
					<span>
						- Khách hàng vui lòng liên hệ với DOUCÉ qua fanpage hoặc Zalo khi có phát sinh vấn đề cần đổi trả để trao đổi và xác nhận thông tin trước.
					</span><br />
					<span>
						- Khách hàng đóng gói và gửi trả sản phẩm cho chúng tôi thông qua đơn vị vận chuyển.
					</span><br />
					<span>
						- Chi phí hoặc sản phẩm hoàn trả sẽ được DOUCÉ gửi lại cho quý khách ngay sau khi chúng tôi nhận được đầy đủ sản phẩm lỗi và xác nhận tình trạng liên quan.
					</span><br />
					<span>
						- Nếu có nhu cầu được hướng dẫn chi tiết hơn về cách thức hoàn trả sản phẩm, Quý khách hàng có thể liên hệ với bất kỳ kênh chăm sóc khách hàng nào bao gồm Fanpage, Zalo, hotline hoặc email để được hỗ trợ sớm nhất có thể.
					</span><br />
				</div>
				<h5>5. Chi phí liên quan đến việc hoàn trả sản phẩm:</h5>
				<div class="mb-4 p-2">
					<span>
						- Đối với trường hợp khách hàng hoàn trả sản phẩm do lỗi của DOUCÉ, chúng tôi xin chịu hoàn toàn chi phí về việc hoàn trả sản phẩm lẫn phí vận chuyển.
					</span><br />
					<span>
						- Trên  tinh thần phục vụ và cầu thị, DOUCÉ cam kết cố gắng thực hiện các vấn đề đổi trả nhanh chóng và chính xác nhất.
					</span><br />
					<span>
						- Trong trường hợp chúng tôi không còn sản phẩm tương tự (cùng mã hàng) để hoàn, chúng tôi có thể: Hoàn sản phẩm khác có giá trị bằng, nếu khách chọn sản phẩm có giá cao hoặc thấp hơn, phần chênh lệch sẽ được bù thêm bởi khách hoặc trả lại bởi DOUCÉ.
					</span><br />
				</div>
			</div>
		</div>
	</div>
</section>