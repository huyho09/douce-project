@{
	Layout = "~/Views/Shared/_DetailLayout.cshtml";
}


<!-- Main Content -->
<div class="container main d-flex">
	<!-- Text Section -->
	<div class="text-content">
		<h1>THE<br>NIGHT<br>TREASURE</h1>
		<p><span style="padding-left: 40px;">The night treasure Parfum embodies a new facet of love.</span></p>
		
	</div>
	<div class="product-display d-flex flex-column">
		<img src="~/images/default_frag.png" alt="Perfume Bottle">
		<div>
			<button class="add-to-cart">Add to cart +</button>
		</div>	
	</div>
	<!-- Product Image & Info -->
	<div class="product-display">
		
		<div class="product-info">
			<h3>$100.45</h3>
			<div class="stars">
				★★★★☆
			</div>
			<div class="details">30 mL</div>
			<div class="controls">
				<i class="fas fa-chevron-left"></i>
				<i class="fas fa-chevron-right"></i>
			</div>
		</div>
	</div>
</div>

