@model ScentifyWebApp.Models.Dtos.DtoPerfume
@{
	ViewData["Title"] = $"{Model.Name} Details";
}
@{
	var firstSized = Model.ProductSizes?[0].VolumeMl;
	var secondSized = Model.ProductSizes?[1].VolumeMl;

	var image1 = Model.ProductSizes?[0].ImageUrl;
	var image2 = Model.ProductSizes?[1].ImageUrl;
}
<link rel="stylesheet" href="~/css/ProductDetailPage.css" />

<style>

</style>
@if (Model != null)
{
	var priceInfo = Model.ProductSizes?.FirstOrDefault(m => m.VolumeMl == Model.CurrentSize);
	var ListDescriptionImages = Model.ListDescriptionImages;
	<!-- Main Content -->
	<div class="m-0">
		<div class="row m-0">
			<div id="carousel-detail" class="carousel slide" data-ride="carousel">
				<div class="slider DetailSwiper">
					<div>
						<img src="@Url.Content(image1?.Replace("./", "~/"))" alt="Slide 0">
					</div>
					<div>
						<img src="@Url.Content(image2?.Replace("./", "~/"))" alt="Slide 1">
					</div>
					@if (ListDescriptionImages?.Count > 0)
					{
						foreach (var image in ListDescriptionImages) {
							<div>
								<img src="@image" alt="Slide Image">
							</div>
						}
					}

					@* <div>
						<img src="https://www.dior.com/dw/image/v2/BGXS_PRD/on/demandware.static/-/Sites-master_dior/default/dw7d659be1/Y0958160/Y0958160_F095355009_E02_GHC.jpg?sw=1024" alt="Slide 2">
					</div>
					<div>
						<img src="https://www.dior.com/dw/image/v2/BGXS_PRD/on/demandware.static/-/Sites-master_dior/default/dwfa81c311/Y0909280/Y0909280_F090955009_E02_GHC.jpg?sw=1280" alt="Slide 3">
					</div> *@

				</div>

			</div>
			<div class="col-12 col-md-8 pc-view-hero-detail">
				<div class="container">
					<div class="row">
						<div class="row">
							<div class="col-12 d-flex justify-content-center">
								<img id="img-product-@firstSized" class="img-fluid" loading="lazy" alt="@Model.Name - firstSized"
								style="@(Model.CurrentSize == firstSized ? "" : "display:none")" src="@Url.Content(image1?.Replace("./", "~/"))">
								<img id="img-product-@secondSized" class="img-fluid" loading="lazy" alt="@Model.Name - secondSized"
								style="@(Model.CurrentSize == secondSized ? "" : "display:none")" src="@Url.Content(image2?.Replace("./", "~/"))">
							</div>
						</div>

						@if (ListDescriptionImages?.Count > 0)
						{
							for (int i = 0; i < ListDescriptionImages.Count; i += 2)
							{
								<div class="row mb-3">
									<div class="col-md-6">
										<img src="@ListDescriptionImages[i]" class="img-fluid" alt="Image @i" />
									</div>

									@if (i + 1 < ListDescriptionImages.Count)
									{
										<div class="col-md-6">
											<img src="@ListDescriptionImages[i + 1]" class="img-fluid" alt="Image @(i + 1)" />
										</div>
									}
								</div>
							}
						}
						@* <div class="row">
							<div class="col-md-6">
								<img src="https://www.dior.com/dw/image/v2/BGXS_PRD/on/demandware.static/-/Sites-master_dior/default/dw7d659be1/Y0958160/Y0958160_F095355009_E02_GHC.jpg?sw=1024"
									 class="img-fluid" alt="Image 2">
							</div>
							<div class="col-md-6">
								<img src="https://www.dior.com/dw/image/v2/BGXS_PRD/on/demandware.static/-/Sites-master_dior/default/dwfa81c311/Y0909280/Y0909280_F090955009_E02_GHC.jpg?sw=1280"
									 class="img-fluid" alt="Image 3">
							</div>
						</div> *@
					</div>
				</div>
			</div>
			<div class="col-12 col-md-4">
				<!-- Product Image & Info -->
				<div class="d-block product-info-container">
					<!-- Text Section -->
					<div class="text-content w-100" style="text-align:center;">
						<h2>@Model.Name</h2>
						<p class="text-content-detail"><span>@Model.ShortDescription</span></p>
					</div>
					<div class="product-info">
						<p id="the-price-currency">@priceInfo?.Price.ToString("N0") @priceInfo.Currency</p>
						@if (Model.ProductSizes != null && Model.ProductSizes.Any())
						{
							var indexItem = 0;
							<div class="d-flex justify-content-center">
								@foreach (var item in Model.ProductSizes)
								{
									<input id="vol-detail-@(indexItem)" class="vol-detail @(indexItem == 0 ? "vol-detail-active" : "")" data-volume="@item.VolumeMl" data-price="@item.Price.ToString("N0")" data-currency="@item.Currency" type="button" value="@item.VolumeMl ml">
									indexItem++;
								}
							</div>
						}
						<div>
							<button class="add-to-cart add-to-cart-btn" data-current-size="@Model.CurrentSize" aria-label="Add to your cart - @priceInfo?.Currency @priceInfo?.Price" data-id="@Model.Id">Thêm giỏ hàng</button>
						</div>
					</div>

					<div class="tabs">
						<input type="radio" class="tab-radio" id="tab1" name="tab" checked>
						<input type="radio" class="tab-radio" id="tab2" name="tab">

						<div class="tab-labels">
							<label for="tab1">Các nốt hương chính</label>
							<label for="tab2">Mô tả</label>
						</div>

						<div class="content">
							<div class="tab-content" id="content1">
								<p class="col-md-8 col-sm-12">
									<ul class="home-detail" style="text-align: left; padding-left:0px;">
										<li>Top Notes: @Model.TopPerfumed</li>
										<li>Heart Notes: @Model.MiddlePerfumed</li>
										<li>Base Notes: @Model.BasePerfumed</li>
									</ul>
								</p>
								<!-- Second Section -->
								<section class="second-section">
									<div class="section-content container">

										@{
											var ingredients = Model.DtoIngredients;
											if (ingredients != null && ingredients.Count > 0)
											{
												<!-- Ingredients Cards -->
												<div class="cards">
													@foreach (var ingredient in ingredients)
													{
														@if (!string.IsNullOrEmpty(ingredient.Name) && !string.IsNullOrEmpty(ingredient.ImageUrl))
														{
															<div class="card car-no-border">
																<h5 class="small">@ingredient.Name</h5>
																@*<p>@ingredient.Description</p>*@
																<img src="@ingredient.ImageUrl" alt="Bergamot">
															</div>
														}
													}
												</div>
											}


										}

										<!-- Navigation Controls -->
										<!--<div class="nav-controls">
										<button class="nav-btn"><i class="fas fa-chevron-left"></i></button>
										<button class="nav-btn"><i class="fas fa-chevron-right"></i></button>
										</div>-->
									</div>
								</section>
							</div>
							<div class="tab-content" id="content2">
								@if (!string.IsNullOrEmpty(Model.Description))
								{
									<p>@Html.Raw(Model.Description)</p>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Info Sections -->
	@* <div class="info-sections">
			<div class="section">
				<div class="number">01</div>
				<div class="title">DESCRIPTION</div>
				<span class="text-content">@Model.Description</span>
			</div>
			<div class="section">
				<div class="number">02</div>
				<div class="title">PERFUMED NOTES</div>
				<span class="text-content">@Html.Raw(Model.Perfumed_Notes)</span>
			</div>
			<div class="section">
				<div class="number">03</div>
				<div class="title">FLACON</div>
				<span class="text-content">@Model.Flacon</span>
			</div>
			<div class="section">
				<div class="number">04</div>
				<div class="title">COMPOSITION</div>
				<span class="text-content">@Model.Composition</span>
			</div>
		</div> *@



	<!-- Third Section -->
	<section class="third-section container mt-5">
		<div class="section-content">
			<!-- Heading -->
			<div class="section-heading">
				<h2 class="section-title">Những sản phẩm khác</h2>
			</div>
			@{
				var similarItems = Model.SimilarPerfumes;
				if (similarItems != null && similarItems.Count > 0)
				{
					var index = 1;
					<!-- Product Cards -->
					<div class="product-cards d-flex justify-content-center">
						@foreach (var similarItem in similarItems)
						{
							var img1 = similarItem.ProductSizes?[0].ImageUrl != null ? similarItem.ProductSizes?[0].ImageUrl.Replace("./", "~/") : "";
							var itemIngredients = string.Join(", ", similarItem.DtoIngredients?.Select(m => m.Name.Trim()) ?? new List<string>());
							<a href="/products/details/@similarItem.Id" class="product-card">
								<img src="@img1" alt="@similarItem.Name">
								<div class="card-content">
									<h4>@similarItem.Name</h4>
									<p>@itemIngredients</p>
									@*<a href="/products/details/@similarItem.Id" class="learn-more">LEARN MORE</a>*@
								</div>
							</a>
							index++;
						}
					</div>
				}
			}

			<!-- Navigation Controls -->
			<!--<div class="nav-controls">
				<button class="nav-btn"><i class="fas fa-chevron-left"></i></button>
				<button class="nav-btn"><i class="fas fa-chevron-right"></i></button>
			</div>-->
		</div>
	</section>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
	$(document).ready(function () {
		//$("input[name='sku']:radio").change(function () {
		//	var price = $(this).data("price") || "";
		//	var currency = $(this).data("currency") || "";
		//	var volume = $(this).data("volume") || 0;

		//	$('[id*="img-product-"]').hide();
		//	$('#img-product-' + volume).show();

		//	$('.slider').slick('slickGoTo', 1);
		//	if (price && currency) {
		//		$("#the-price-currency").text(price.toLocaleString("en-US", { maximumFractionDigits: 0 }) + " " + currency);
		//	}
		//	$(".add-to-cart-btn").attr("data-current-size", volume);
		//});
		$("#vol-detail-0").click(function () {
			$(".vol-detail").removeClass("vol-detail-active");
			$(this).addClass("vol-detail-active");
			var price = $(this).data("price") || "";
			var currency = $(this).data("currency") || "";
			var volume = $(this).data("volume") || 0;
			$('[id*="img-product-"]').hide();
			$('#img-product-' + volume).show();
			$('.slider').slick('slickGoTo', 0);
			if (price && currency) {
				$("#the-price-currency").text(price.toLocaleString("en-US", { maximumFractionDigits: 0 }) + " " + currency);
			}
			$(".add-to-cart-btn").attr("data-current-size", volume);
		});
		$("#vol-detail-1").click(function () {
			$(".vol-detail").removeClass("vol-detail-active");
			$(this).addClass("vol-detail-active");
			var price = $(this).data("price") || "";
			var currency = $(this).data("currency") || "";
			var volume = $(this).data("volume") || 1;
			$('[id*="img-product-"]').hide();
			$('#img-product-' + volume).show();
			$('.slider').slick('slickGoTo', 1);
			if (price && currency) {
				$("#the-price-currency").text(price.toLocaleString("en-US", { maximumFractionDigits: 0 }) + " " + currency);
			}
			$(".add-to-cart-btn").attr("data-current-size", volume);
		});
		$("*").each(function () {
			var color = $(this).css("color");
			if (color === "rgb(0, 0, 0)") {
				// Remove only the `color` inline style, keep other styles intact
				var currentStyle = $(this).attr("style");
				if (currentStyle) {
					var newStyle = currentStyle.replace(/color:\s*rgb\(0,\s*0,\s*0\);?/gi, "").trim();
					// Clean up trailing semicolons and extra spaces
					newStyle = newStyle.replace(/;{2,}/g, ";").replace(/^;|;$/g, "");
					if (newStyle) {
						$(this).attr("style", newStyle);
					} else {
						$(this).removeAttr("style");
					}
				}
			}
		});

	});

</script>