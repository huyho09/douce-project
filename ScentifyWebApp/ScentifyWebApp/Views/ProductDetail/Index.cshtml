@model ScentifyWebApp.Models.Entities.Perfume


@if (Model != null)
{
	<!-- Main Content -->
	<div class="container main d-flex">
		<!-- Text Section -->
		<div class="text-content">
			<h1>@Model.Name</h1>
			<p class="text-content-detail"><span style="padding-left: 40px;">@Model.ShortDescription</span></p>

		</div>
		<div class="product-display d-flex flex-column">
			<img loading="lazy" alt="@Model.Name" src="@Url.Content(Model.ImageUrl.Replace("./","~/"))">
			<div>
				<button class="add-to-cart">Add to cart +</button>
			</div>
		</div>
		<!-- Product Image & Info -->
		<div class="product-display">

			<div class="product-info">
				<h3>$@Model?.Price</h3>
				<div class="stars">
					★★★★☆
				</div>
				<div class="details">@Model?.VolumeMl ml</div>
				<div class="controls">
					@*<i class="fas fa-chevron-left"></i>
					<i class="fas fa-chevron-right"></i>*@
				</div>
			</div>
		</div>
	</div>

	<!-- Info Sections -->
	<div class="info-sections">
		<div class="section">
			<div class="number">01</div>
			<div class="title">DESCRIPTION</div>
			<span class="text-content">@Model.Description</span>
		</div>
		<div class="section">
			<div class="number">02</div>
			<div class="title">PERFUMED NOTES</div>
			<span class="text-content">@Model.Description</span>
		</div>
		<div class="section">
			<div class="number">03</div>
			<div class="title">FLACON</div>
		</div>
		<div class="section">
			<div class="number">04</div>
			<div class="title">COMPOSITION</div>
		</div>
	</div>

	<!-- Second Section -->
	<section class="second-section">
		<div class="section-content container">
			<h2 class="section-title">A Symphony of Nature’s Finest</h2>
			<p class="section-subtitle">
				A luxurious fusion of delicate florals and warm vanilla, crafted to evoke passion and timeless elegance.
			</p>

			<!-- Ingredients Cards -->
			<div class="cards">
				<!-- Card 1 -->
				<div class="card">
					<img src="~/images/bergamot.png" alt="Bergamot">
					<h3>BERGAMOT</h3>
					<p>A zesty and refreshing citrus note.</p>
				</div>

				<!-- Card 2 - Highlighted -->
				<div class="card center">
					<img src="~/images/lavender.png" alt="Lavender">
					<h3>LAVENDER</h3>
					<p>more commonly known as the Damask rose.</p>
				</div>

				<!-- Card 3 -->
				<div class="card">
					<img src="~/images/pepper.png" alt="Pepper">
					<h3>PEPPER</h3>
					<p>A soothing floral note that balances the intensity.</p>
				</div>
			</div>

			<!-- Navigation Controls -->
			<!--<div class="nav-controls">
				<button class="nav-btn"><i class="fas fa-chevron-left"></i></button>
				<button class="nav-btn"><i class="fas fa-chevron-right"></i></button>
			</div>-->
		</div>
	</section>

	<!-- Third Section -->
	<section class="third-section container">
		<div class="section-content">
			<!-- Heading -->
			<div class="section-heading">
				<p class="section-label">SIMILAR PRODUCTS</p>
				<h2 class="section-title">The fragrance larger than life.</h2>
			</div>

			<!-- Product Cards -->
			<div class="product-cards d-flex justify-content-center">
				<!-- Card 1 -->
				<div class="product-card">
					<img src="~/images/default_frag.png" alt="The Night Treasure">
					<div class="card-content">
						<h3>01</h3>
						<h4>The night treasure</h4>
						<p>L'amour est un trésor. Depuis sa création en 1990, l'Eau de absolu sous toute.</p>
						<a href="#" class="learn-more">LEARN MORE</a>
					</div>
				</div>

				<!-- Card 2 -->
				<div class="product-card">
					<img src="~/images/default_frag.png" alt="The Night Treasure">
					<div class="card-content">
						<h3>02</h3>
						<h4>The night treasure</h4>
						<p>L'amour est un trésor. Depuis sa création en 1990, l'Eau de absolu sous toute.</p>
						<a href="#" class="learn-more">LEARN MORE</a>
					</div>
				</div>
				<!-- Card 3 -->
				<div class="product-card">
					<img src="~/images/default_frag.png" alt="The Night Treasure">
					<div class="card-content">
						<h3>02</h3>
						<h4>The night treasure</h4>
						<p>L'amour est un trésor. Depuis sa création en 1990, l'Eau de absolu sous toute.</p>
						<a href="#" class="learn-more">LEARN MORE</a>
					</div>
				</div>
			</div>

			<!-- Navigation Controls -->
			<!--<div class="nav-controls">
				<button class="nav-btn"><i class="fas fa-chevron-left"></i></button>
				<button class="nav-btn"><i class="fas fa-chevron-right"></i></button>
			</div>-->
		</div>
	</section>
}