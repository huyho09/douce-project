@model ScentifyWebApp.Models.Dtos.DtoPerfume
@{
	ViewData["Title"] = $"{Model.Name} Details";
}

@if (Model != null)
{
	var priceInfo = Model.ProductSizes?.FirstOrDefault();

	<!-- Main Content -->
	<div class="container main d-flex">
		<!-- Text Section -->
		<div class="text-content">
			<h1>@Model.Name</h1>
			<p class="text-content-detail"><span style="padding-left: 40px;">@Model.ShortDescription</span></p>

		</div>
		<div class="product-display d-flex flex-column">
			<img loading="lazy" alt="@Model.Name" src="@Url.Content(Model.ImageUrl.Replace("./", "~/"))">
			<div>
				<button class="add-to-cart add-to-cart-btn" data-current-size="@Model.CurrentSize" aria-label="Add to your cart - @priceInfo.Currency @priceInfo.Price" data-id="@Model.Id">Add to cart +</button>
			</div>
		</div>
		<!-- Product Image & Info -->
		<div class="product-display">

			<div class="product-info">
				<h3 id="the-price-currency">@priceInfo.Price @priceInfo.Currency</h3>
				@if (Model.ProductSizes != null && Model.ProductSizes.Any())
				{
					<ul class="RadioGroup_base__ttFz5 ProductDetailBody_variants__0uwqK Transition_shiftInDownEnterDone__X_OxP">
						@foreach (var item in Model.ProductSizes)
						{
							<li class="RadioGroup_radio__hnn9G">
								<label class="RadioGroup_label__ACZd_" for="size-@item.VolumeMl">
									<input aria-checked="@(Model.CurrentSize == item.VolumeMl)" class="RadioGroup_input__fjmeL" data-test-ref="PRODUCT_DETAIL_VARIANT_SELECT" data-volume="@item.VolumeMl" data-price="@item.Price" data-currency="@item.Currency" id="size-@item.VolumeMl" name="sku" tabindex="0" type="radio" value="@item.VolumeMl" @(Model.CurrentSize == item.VolumeMl ? "checked" : "")>
									<span class="RadioGroup_pot__g3kNx RadioGroup_dark__cngsS"></span>
									<span class="RadioGroup_labelContent__48GiJ RadioGroup_dark__cngsS">@item.VolumeMl mL</span>
								</label>
							</li>
						}
					</ul>
				}

				<div class="controls">

				</div>
			</div>
		</div>
	</div>

	<!-- Info Sections -->
	@* <div class="info-sections">
			<div class="section">
				<div class="number">01</div>
				<div class="title">DESCRIPTION</div>
				<span class="text-content">@Model.Description</span>
			</div>
			<div class="section">
				<div class="number">02</div>
				<div class="title">PERFUMED NOTES</div>
				<span class="text-content">@Html.Raw(Model.Perfumed_Notes)</span>
			</div>
			<div class="section">
				<div class="number">03</div>
				<div class="title">FLACON</div>
				<span class="text-content">@Model.Flacon</span>
			</div>
			<div class="section">
				<div class="number">04</div>
				<div class="title">COMPOSITION</div>
				<span class="text-content">@Model.Composition</span>
			</div>
		</div> *@

	<!-- Second Section -->
	<section class="second-section">
		<div class="section-content container">
			<h2 class="section-title">A Symphony of Nature’s Finest</h2>
			<p class="section-subtitle">
				A luxurious fusion of delicate florals and warm vanilla, crafted to evoke passion and timeless elegance.
			</p>

			@{
				var ingredients = Model.DtoIngredients;
				if (ingredients != null && ingredients.Count > 0)
				{
					<!-- Ingredients Cards -->
					<div class="cards">
						@foreach (var ingredient in ingredients)
						{
							<div class="card">
								<img src="@ingredient.ImageUrl" alt="Bergamot">
								<h3>@ingredient.Name</h3>
								<p>@ingredient.Description</p>
							</div>
						}
					</div>
				}


			}

			<!-- Navigation Controls -->
			<!--<div class="nav-controls">
			<button class="nav-btn"><i class="fas fa-chevron-left"></i></button>
			<button class="nav-btn"><i class="fas fa-chevron-right"></i></button>
			</div>-->
		</div>
	</section>
	@if (!string.IsNullOrEmpty(Model.Description))
	{
		<section class="third-section container mb-0">
			<div class="section-content">
				<!-- Heading -->
				<div class="section-heading">
					<h2 class="section-title">Description</h2>
					<div class="section-label">@Html.Raw(Model.Description)</div>
				</div>
			</div>
		</section>
	}
	<!-- Third Section -->
	<section class="third-section container mt-0">
		<div class="section-content">
			<!-- Heading -->
			<div class="section-heading">
				<p class="section-label">SIMILAR PRODUCTS</p>
				<h2 class="section-title">The fragrance larger than life.</h2>
			</div>
			@{
				var similarItems = Model.SimilarPerfumes;
				if (similarItems != null && similarItems.Count > 0)
				{
					var index = 1;
					<!-- Product Cards -->
					<div class="product-cards d-flex justify-content-center">
						@foreach (var similarItem in similarItems)
						{
							<a href="/products/details/@similarItem.Id" class="product-card">
								<img src="@similarItem.ImageUrl" alt="@similarItem.Name">
								<div class="card-content">
									<h3>0@(index)</h3>
									<h4>@similarItem.Name</h4>
									<p>@similarItem.ShortDescription</p>
									@*<a href="/products/details/@similarItem.Id" class="learn-more">LEARN MORE</a>*@
								</div>
							</a>
							index++;
						}
					</div>
				}
			}

			<!-- Navigation Controls -->
			<!--<div class="nav-controls">
				<button class="nav-btn"><i class="fas fa-chevron-left"></i></button>
				<button class="nav-btn"><i class="fas fa-chevron-right"></i></button>
			</div>-->
		</div>
	</section>
}
<script src="~/js/jquery-1.11.0.min.js"></script>
<script>
	$(document).ready(function () {
		$("input[name='sku']:radio").change(function () {
			var price = $(this).data("price") || "";
			var currency = $(this).data("currency") || "";
			var currency = $(this).data("volume") || 0;
			if (price && currency) {
				$("#the-price-currency").text(price + " " + currency);
			}
			$(".add-to-cart-btn").attr("data-current-size", currency);
		});
		$("*").each(function () {
			var color = $(this).css("color");
			if (color === "rgb(0, 0, 0)") {
				// Remove only the `color` inline style, keep other styles intact
				var currentStyle = $(this).attr("style");
				if (currentStyle) {
					var newStyle = currentStyle.replace(/color:\s*rgb\(0,\s*0,\s*0\);?/gi, "").trim();
					// Clean up trailing semicolons and extra spaces
					newStyle = newStyle.replace(/;{2,}/g, ";").replace(/^;|;$/g, "");
					if (newStyle) {
						$(this).attr("style", newStyle);
					} else {
						$(this).removeAttr("style");
					}
				}
			}
		});

	});

</script>