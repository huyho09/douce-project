@model List<ScentifyWebApp.Models.CartItem>

@{
    var orderId = Guid.NewGuid().ToString();
    decimal amount = 0;
}


@if (Model != null && Model.Count > 0)
{
    foreach (var cartItem in Model)
    {
        var perfume = cartItem.Product;
        var currentProductSizes = perfume.ProductSizes?.FirstOrDefault(x => x.VolumeMl == perfume.CurrentSize);
        <div class="product">
            <img src="@currentProductSizes?.ImageUrl" alt="@perfume.Name">
            <div class="product-details">
                <p class="product-name">@perfume.Name</p>
                <p class="product-size">@cartItem.VolumeMl mL - @currentProductSizes?.Price.ToString("N0") @currentProductSizes?.Currency</p>
                <span class="product-price" style="display:none;">@currentProductSizes?.Price.ToString("N0")</span>
            </div>
            <div class="rub-item">
                <input type="number" class="quantity form-control-sm w-75" value="@cartItem.Quantity" min="1" onchange="updateCartIteminCheckOut(this,'@perfume.Id', @perfume.CurrentSize);" />
                <button class="remove-cart-btn" type="button" onclick="removeCartItemInCheckOut(this,'@perfume.Id', @perfume.CurrentSize);">✕</button>
            </div>
        </div>
        amount += ((currentProductSizes?.Price ?? 0) * cartItem.Quantity);
    }
}

<hr>
<div class="price-details">
    <div class="summary-item"><span>Tổng số lượng</span><span id="total-quantity">@Model?.Sum(m => m.Quantity)</span></div>
    <div class="summary-total"><span>Hóa đơn tạm tính</span><span id="total-price">@amount.ToString("N0") @Model?.FirstOrDefault()?.Currency</span></div>
    <p class="mt-5"><strong>Lưu ý</strong>: Hóa đơn tạm tính chưa bao gồm phí ship. Đơn hàng cả quý khách sẽ được ship COD. Nếu có nhu cầu thanh toán chuyển khoản trước, vui lòng liên hệ trực tiếp 
        <a class="link-primary font-weight-bold" target="_self" href="https://www.facebook.com/Douce.Perfume">fanpage</a> để được hỗ trợ.
    </p>
</div>

