@model List<ScentifyWebApp.Models.CartItem>

@{
    var orderId = Guid.NewGuid().ToString();
    decimal amount = 0;
}


@if (Model != null && Model.Count > 0)
{
    foreach (var cartItem in Model)
    {
        var perfume = cartItem.Product;
        var currentProductSizes = perfume.ProductSizes.FirstOrDefault(x => x.VolumeMl == perfume.CurrentSize);
        <div class="product">
            <img src="@perfume.ImageUrl" alt="@perfume.Name">
            <div class="product-details">
                <p class="product-name">@perfume.Name</p>
                <p class="product-size">@cartItem.VolumeMl</p>
                <button class="btn remove" type="button" onclick="removeCartItemInCheckOut(this,'@perfume.Id', @perfume.CurrentSize);">Bỏ</button>
            </div>
            <input type="number" class="quantity form-control-sm w-25" value="@cartItem.Quantity" min="1" onchange="updateCartIteminCheckOut(this,'@perfume.Id');" />
            <span class="product-price">@currentProductSizes.Price.ToString("N2")</span>
        </div>
        amount += currentProductSizes.Price * cartItem.Quantity;
    }
}

<hr>
<div class="price-details">
	<div class="summary-item"><span>Tổng số lượng</span><span id="total-quantity">@Model?.Sum(m => m.Quantity)</span></div>
	<div class="summary-total"><span>Tổng hoá đơn</span><span id="total-price">@amount @Model.FirstOrDefault().Currency</span></div>
</div>

