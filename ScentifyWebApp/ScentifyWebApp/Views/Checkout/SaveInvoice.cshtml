@using ScentifyWebApp.Models.Requests;

@{
	ViewData["Title"] = "Checkout page";
}

@model CheckoutRequest


<section class="checkout-container">
	<div class="form-section justify-content-start">
		<nav class="breadcrumb">
			<a href="/home">Trang chủ</a> &gt; <span class="active">Thanh Toán</span>
		</nav>
		<h2><strong>Phương thức thanh toán</strong></h2>
		@*@await Html.PartialAsync("_UserInfoForm", Model)*@
		<p>
			Noted: Để order sản phẩm, bạn có thể liên lạc với chủ shop thông qua <a class="link-light" href="https://www.facebook.com/">Fanpage</a> hoặc zalo <a class="link-light" href="javascript:void(0);">090 999 9877</a>
		</p>
	</div>

	<div class="order-summary">
			@await Html.PartialAsync("_ListCart", Model.CartItems)
		</div>
</section>



