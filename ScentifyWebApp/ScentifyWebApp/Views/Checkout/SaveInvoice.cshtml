@using ScentifyWebApp.Models.Requests;

@{
    ViewData["Title"] = "Checkout page";
}

@model CheckoutRequest


<section class="checkout-container">
    <div class="form-section">
        <nav class="breadcrumb">
            <a href="/home">Home</a> &gt; <span class="active">Checkout</span>
        </nav>
        <h2>Where would you like your order sent?</h2>
        @await Html.PartialAsync("_UserInfoForm", Model)
    </div>

    <div class="order-summary">
        @await Html.PartialAsync("_ListCart", Model.CartItems)
    </div>
</section>

<script>
    document.querySelector('header.custom-navbar').style.display = 'none';
</script>

