@{
    var orderId = Guid.NewGuid().ToString();
    double amount = 165000;
}
<section class="checkout-container">
    <div class="form-section">
        <nav class="breadcrumb">
            <a href="/home">Home</a> &gt; <span class="active">Checkout</span>
        </nav>
        <h2>Where would you like your order sent?</h2>

        <form class="checkout-form" id="checkout-form">
            <input type="hidden" id="orderId" value="@orderId" />
            <input type="hidden" id="amount" value="@amount" />
            <!-- Row 1: Title, First Name, Last Name -->
            <div class="form-row">
                <div class="floating-group">
                    <select id="title" name="title" required>
                        <option selected value="Dr">Dr</option>
                        <option value="Mr">Mr</option>
                        <option value="Ms">Ms</option>
                    </select>
                    <label for="title">Title</label>
                </div>

                <div class="floating-group">
                    <input type="text" id="first-name" name="first-name" value="John" required>
                    <label for="first-name">First name</label>
                </div>

                <div class="floating-group">
                    <input type="text" id="last-name" name="last-name" value="Smith" required>
                    <label for="last-name">Last name</label>
                </div>
            </div>

            <!-- Row 2: Country Selector, Address -->
            <div class="form-row">
                <div class="floating-group">
                    <select id="country" name="country" required>
                        <option value="france">France</option>
                        <option selected value="germany">Germany</option>
                        <option value="usa">USA</option>
                    </select>
                    <label for="country">Country / Region</label>
                </div>

                <div class="floating-group">
                    <input type="text" id="address" name="address" value="1234 Elm Street, Apt 56, Springfield, IL 62704" required>
                    <label for="address">Address</label>
                </div>
            </div>

            <button class="continue-btn" type="submit">Confirm completed invoice</button>
        </form>
    </div>

    <div class="order-summary">
        <div class="price-details">
            <div class="summary-item"><span>Subtotal</span><span>€@amount</span></div>
            <div class="summary-item"><span>Shipping fee</span><span>€0.00</span></div>
            <div class="summary-item"><span>Included taxes</span><span>€0.00</span></div>
            <div class="summary-total"><span>Total</span><span>€165.00</span></div>
        </div>

        <div class="product">
            <img src="./images/per_4.png" alt="Gloam Eau de Parfum">
            <div class="product-details">
                <p class="product-name">Gloam Eau de Parfum</p>
                <p class="product-size">50 mL</p>
                <a href="#" class="remove">Remove</a>
            </div>
            <select class="quantity">
                <option>1</option>
                <option selected>2</option>
                <option>3</option>
            </select>
            <span class="product-price">€165.00</span>
        </div>

        <hr>

        <div class="section">
            <img src="./images/sample.png" alt="Samples">
            <div>
                <p class="section-title">Complimentary samples</p>
                <p>No samples</p>
            </div>
            <a href="#" class="edit">Edit</a>
        </div>

        <hr>

        <div class="section">
            <img src="./images/gift.png" alt="Gift Option">
            <div>
                <p class="section-title">Is this order a gift?</p>
            </div>
            <a href="#" class="edit">Edit</a>
        </div>

        <button class="chat-btn">💬</button>

    </div>
</section>

<script>
    document.querySelector('header.custom-navbar').style.display = 'none';
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("checkout-form").addEventListener("submit", function(event) {
            event.preventDefault(); // Prevent form from reloading the page

            const orderId = document.getElementById("orderId").value;
            const amount = document.getElementById("amount").value;

            fetch("/pay?orderId=" + orderId + "&amount=" + amount, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {
                if (data.payUrl) {
                    // Redirect user to MoMo payment page
                    window.location.href = data.payUrl;
                } else {
                    document.getElementById("paymentResult").innerHTML = `<p style="color: red;">Error: ${data.message}</p>`;
                }
            })
            .catch(error => {
                console.error("Error:", error);
                document.getElementById("paymentResult").innerHTML = `<p style="color: red;">Failed to connect to payment API.</p>`;
            });
        });
    });
</script>