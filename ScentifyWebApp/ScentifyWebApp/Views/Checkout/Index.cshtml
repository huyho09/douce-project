@{
    ViewData["Title"] = "Checkout page";
}

@model List<ScentifyWebApp.Models.CartItem>

@{
    var orderId = Guid.NewGuid().ToString();
    var amount = Model.Sum(m=>m.Quantity * m.Product.Price).ToString("N2");
}
<section class="checkout-container">
    <div class="form-section">
        <nav class="breadcrumb">
            <a href="/home">Home</a> &gt; <span class="active">Checkout</span>
        </nav>
        <h2>Where would you like your order sent?</h2>

        <form class="checkout-form" id="checkout-form">
            <input type="hidden" id="orderId" value="@orderId" />
            <input type="hidden" id="amount" value="@amount" />
            <!-- Row 1: Title, First Name, Last Name -->
            <div class="form-row">
                <div class="floating-group">
                    @* <select id="title" name="title" required>
                        <option selected value="Dr">Dr</option>
                        <option value="Mr">Mr</option>
                        <option value="Ms">Ms</option>
                    </select> *@
                    <input type="text" id="title" name="title" placeholder="" value="Dr" required>
                    <label for="title">1. Title</label>
                </div>

                <div class="floating-group">
                    <input type="text" id="FirstName" name="FirstName" placeholder="" required>
                    <label for="FirstName">2. First name</label>
                </div>

                <div class="floating-group">
                    <input type="text" id="LastName" name="LastName" placeholder="" required>
                    <label for="LastName">3. Last name</label>
                </div>
            </div>

            <!-- Row 2: Country Selector, Address -->
            <div class="form-row">
                <div class="floating-group">
                    @* <select id="country" name="country" required>
                        <option value="france">France</option>
                        <option selected value="germany">Germany</option>
                        <option value="usa">USA</option>
                    </select> *@
                    <input type="text" id="country" name="country" placeholder="" value="France" required>
                    <label for="country">4. Country / Region</label>
                </div>

                <div class="floating-group">
                    <input type="text" id="address" name="address" placeholder="" required>
                    <label for="address">5. Address</label>
                </div>
            </div>

            <button class="continue-btn" type="button" onclick="saveCart();">Confirm completed invoice</button>
        </form>
    </div>

    <div class="order-summary">
        <div class="price-details">
            <div class="summary-item"><span>Subtotal</span><span>€@amount</span></div>
            <div class="summary-item"><span>Shipping fee</span><span>€0.00</span></div>
            <div class="summary-item"><span>Included taxes</span><span>€0.00</span></div>
            <div class="summary-total"><span>Total</span><span>€@amount</span></div>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            foreach (var cartItem in Model)
            {
                var perfume = cartItem.Product;
                <div class="product">
                    <img src="@perfume.ImageUrl" alt="@perfume.Name">
                    <div class="product-details">
                        <p class="product-name">@perfume.Name</p>
                        <p class="product-size">@perfume.VolumeMl</p>
                        <button class="btn remove" type="button" onclick="removeCartItemInCheckOut(this,'@perfume.Id');">Remove</button>
                    </div>
                    <input type="number" class="quantity form-control-sm w-25" value="@cartItem.Quantity" />
                    <span class="product-price">@perfume.Currency @perfume.Price.ToString("N2")</span>
                </div>
            }
        }

        <hr>

        <div class="section">
            <img src="./images/sample.png" alt="Samples">
            <div>
                <p class="section-title">Complimentary samples</p>
                <p>No samples</p>
            </div>
            <a href="#" class="edit">Edit</a>
        </div>

        <hr>

        <div class="section">
            <img src="./images/gift.png" alt="Gift Option">
            <div>
                <p class="section-title">Is this order a gift?</p>
            </div>
            <a href="#" class="edit">Edit</a>
        </div>

        <button class="chat-btn">💬</button>

    </div>
</section>

<script>
    document.querySelector('header.custom-navbar').style.display = 'none';
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("checkout-form").addEventListener("submit", function(event) {
            event.preventDefault(); // Prevent form from reloading the page

            const orderId = document.getElementById("orderId").value;
            const amount = document.getElementById("amount").value;

            fetch("/pay?orderId=" + orderId + "&amount=" + amount, {
                method: "POST"
            })
            .then(response => response.json())
            .then(data => {
                if (data.payUrl) {
                    // Redirect user to MoMo payment page
                    window.location.href = data.payUrl;
                } else {
                    document.getElementById("paymentResult").innerHTML = `<p style="color: red;">Error: ${data.message}</p>`;
                }
            })
            .catch(error => {
                console.error("Error:", error);
                document.getElementById("paymentResult").innerHTML = `<p style="color: red;">Failed to connect to payment API.</p>`;
            });
        });
    });
</script>