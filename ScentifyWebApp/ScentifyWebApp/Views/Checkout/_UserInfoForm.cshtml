@using ScentifyWebApp.Models.Requests;
@model CheckoutRequest

<div id="checkout-form-container">
    <form asp-controller="Checkout" asp-action="SaveInvoice" method="post" class="checkout-form" id="checkout-form">
        <input asp-for="CartItems" type="hidden" placeholder="" value="@Model.CartItems" class="form-control" data-required />
        <p class="h4 product-name mb-4">Thông tin đặt hàng:</p>
        @if (!string.IsNullOrEmpty(ViewData["ErrorPay"]?.ToString())){
            <span class="text-danger">@ViewData["ErrorPay"]</span>
        }
        <!-- Row 1: Title, First Name, Last Name -->
        <div class="form-row">
            @* <div class="floating-group">
                <input type="hidden" asp-for="Title" id="selectedTitle" value="Dr">
                <select id="customSelect" asp-for="Title" class="form-control" data-required onchange="changeSelectTitle(this);">
                    <option value="Dr" selected>Dr</option>
                    <option value="Mr">Mr</option>
                    <option value="Ms">Ms</option>
                    <option value="Mrs">Mrs</option>
                </select>
                <label asp-for="Title">1. Title</label>
                <span class="text-danger" asp-validation-for="Title"></span>
            </div> *@

            <div class="floating-group">
                <input asp-for="FullName" placeholder="" class="form-control" data-required />
                <label asp-for="FullName">1. Họ tên</label>
                <span class="text-danger" asp-validation-for="FullName"></span>
            </div>

            @* <div class="floating-group">
                <input asp-for="LastName" placeholder="" class="form-control" data-required />
                <label asp-for="LastName">3. Last name</label>
                <span class="text-danger" asp-validation-for="LastName"></span>
            </div> *@

            <div class="floating-group">
                <input asp-for="PhoneNumber" placeholder="" class="form-control" data-required />
                <label asp-for="PhoneNumber">2. Số điện thoại</label>
                <span class="text-danger" asp-validation-for="PhoneNumber"></span>
            </div>
        </div>

        <!-- Row 2: Email, Phone Number -->
        @* <div class="form-row">
            <div class="floating-group">
                <input asp-for="EmailAddress" placeholder="" class="form-control" data-required />
                <label asp-for="EmailAddress">4. Email Address</label>
                <span class="text-danger" asp-validation-for="EmailAddress"></span>
            </div>

            <div class="floating-group">
                <input asp-for="PhoneNumber" placeholder="" class="form-control" data-required />
                <label asp-for="PhoneNumber">5. Phone Number</label>
                <span class="text-danger" asp-validation-for="PhoneNumber"></span>
            </div>
        </div> *@

        <!-- Row 3: Address -->
        <div class="form-row">
            <div class="floating-group">
                <input asp-for="EmailAddress" placeholder="" class="form-control" data-required />
                <label asp-for="EmailAddress">3. Email</label>
                <span class="text-danger" asp-validation-for="EmailAddress"></span>
            </div>
            <div class="floating-group">
                <input asp-for="Address" placeholder="" class="form-control" data-required />
                <label asp-for="Address">4. Thông tin địa chỉ nhà</label>
                <span class="text-danger" asp-validation-for="Address"></span>
            </div>
        </div>

        <button class="continue-btn" type="submit">Hoàn tất</button>
        <a class="btn link-primary" data-bs-toggle="modal" data-bs-target="#policyModal">
            CHÍNH SÁCH VẬN CHUYỂN
        </a>
    </form>
</div>
