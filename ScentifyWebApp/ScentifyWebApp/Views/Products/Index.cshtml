@model IEnumerable<ScentifyWebApp.Models.Dtos.DtoPerfume>?

@{
    ViewData["Title"] = "Products Page";
}

<section class="podium-section">
    <div class="podium-ref-div">
        <div class="product-commerce-cards">
            <div class="card-wrapper">
                <div class="text-wrapper">
                    <header class="section-heading">
                        @* <b>A bold and unorthodox collection</b> *@
                        <h2>TRANSMUTÉ</h2>
                    </header>
                    <p class="col-md-8 col-sm-12">
                        Trải nghiệm cùng TRANSMUTÉ không đơn thuần là sự đắm chìm trong hương thơm, mà là một nghi thức hóa thân Doucé kiến tạo - nơi hương thơm không chỉ bao bọc mà còn trở thành một phần của bản thể.
                        <br />
                        <br />
                        Những sáng tạo hương TRANSMUTÉ tỏa ra, thấm sâu vào từng chuyển động, như một lớp da thứ hai, như khí chất bẩm sinh. Chúng không rời rạc mà kết tinh trong dòng chảy của chính bạn, lan tỏa mạnh mẽ nhưng liền mạch, quấn lấy thân thể như một dấu ấn vĩnh cửu của sự biến đổi.
                    </p>
                </div>
            </div>

            <div class="product-grid">
                @if (Model != null && Model?.Count() > 0)
                {
                    foreach (var product in Model)
                    {
                        var priceInfoFirst = product.ProductSizes?[0];
                        var priceInfoSecond = product.ProductSizes?[1];
                        <div class="product-grid-item">
                            <!-- Image -->
                            <a href="/products/details/@product.Id" target="_self">
                                <div class="image-wrapper">
                                    <img alt="@product.Name" loading="lazy" src="@product.ImageUrl">
                                </div>
                            </a>

                            <!-- Product Body -->
                            <div class="body-wrapper">
                                <!-- Title -->
                                <h4 class="product-title">
                                    <a href="/products/details/@product.Id" target="_self">
                                        @product.Name
                                    </a>
                                </h4>

                                <!-- Description -->
                                <p class="product-description">@product.ShortDescription</p>

                                <!-- Price Info -->
                                <div class="price-info row">
                                    @if (priceInfoFirst != null)
                                    {
                                        <div class="col pr-1">
                                            <p class="product-price">@priceInfoFirst.VolumeMl mL</p>
											<a href="/products/details/@product.Id/@priceInfoFirst.VolumeMl" class="size-button" aria-label="@priceInfoFirst.Currency @priceInfoFirst.Price - @priceInfoFirst.VolumeMl mL" data-id="@product.Id">@priceInfoFirst.Currency @priceInfoFirst.Price.ToString("N0")</a>
                                        </div>
                                    }
                                    @if (priceInfoSecond != null)
                                    {
                                        <div class="col">
                                            <p class="product-price">@priceInfoSecond.VolumeMl mL</p>
											<a href="/products/details/@product.Id/@priceInfoSecond.VolumeMl" class="size-button" aria-label="@priceInfoSecond.Currency @priceInfoSecond.Price - @priceInfoSecond.VolumeMl mL" data-id="@product.Id">@priceInfoSecond.Currency @priceInfoSecond.Price.ToString("N0")</a>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Call to Action -->
                            @*  <div class="cta-wrapper">
                                <button class="add-to-cart-btn" aria-label="Add to your cart - @priceInfo.Currency @priceInfo.Price" data-id="@product.Id">Add to your cart</button>
                            </div> *@
                        </div>
                    }
                }
            </div>

            <!-- Load More Button -->
            @if (Model?.Count() > 6)
            {
                <div class="load-more-container">
                    @* <p class="fst-italic text-center text-sm-center">About <span id="numofRemaining">
                @(Model?.Count() > 0 ? (Model?.Count() - 6): 0)
                </span> more products remaining... load more if you want to explore.</p> *@

                    <button class="load-more-btn" onclick="loadMoreProducts()">
                        <span>Load More</span>
                        <i class="bi bi-chevron-double-down"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<script>
    let currentPage = 1;
    const itemsPerPage = 3;

    async function loadMoreProducts() {
        const response = await fetch(`/Products/LoadMoreProducts`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ page: currentPage, size: itemsPerPage })
        });
        const products = await response.json();

        if (typeof products !== 'underfined' || products?.length > 0) {
            const container = document.querySelector('.product-grid');
            products.forEach(product => {
                const item = document.createElement('div');
                item.className = 'product-grid-item';
                item.innerHTML = `
                        <div class="product-grid-item">
                            <div class="image-wrapper">
                                <a href="/products/details/${product.id}" target="_self">
                                    <img alt="${product.name}" loading="lazy" src="${product.image}">
                                </a>
                            </div>

                            <div class="body-wrapper">
                                <!-- Title -->
                                <h4 class="product-title">
                                    <a href="/products/details/${product.id}" target="_self">
                                        ${product.name}
                                    </a>
                                </h4>

                                <p class="product-description">${product.shortDescription}</p>

                                <div class="price-info">
                                    <p class="product-size">${product.size}</p>
                                    <div class="unit-pricing">
                                        <span class="product-price">${product.price.amount} ${product.price.currency}</span>
                                        <span>/</span>
                                        <span class="unit-price">${product.price.unitPrice}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="cta-wrapper">
                                <button class="add-to-cart-btn" aria-label="Add to your cart - €${product.price.amount}">Add to your cart</button>
                            </div>
                        </div>`;
                container.appendChild(item);
            });

            currentPage++;
        } else {
            $('.load-more-btn').hide();
        }
    }
</script>