@model IEnumerable<ScentifyWebApp.Models.Product>?

@{
    ViewData["Title"] = "Products Page";
}

<section class="podium-section">
    <div class="podium-ref-div">
        <div class="product-commerce-cards">
            <div class="card-wrapper">
                <div class="text-wrapper">
                    <header class="section-heading">
                        <b>A bold and unorthodox collection</b>
                        <h2>Introducing Othertopias</h2>
                    </header>
                    <p>
                        Comprising six unique fragrances, Othertopias is a series of eaux de parfum designed to
                        transport wearers to realms both real and imagined.
                    </p>
                </div>
            </div>

            <div class="product-grid">
                @if (Model != null && Model?.Count() > 0)
                {
                    foreach (var product in Model)
                    {
                        <div class="product-grid-item">
                            <!-- Image -->
                            <div class="image-wrapper">
                                <a href="/products/details/@product.Id" target="_self">
                                    <img alt="@product.Name" loading="lazy" src="@product.Image">
                                </a>
                            </div>

                            <!-- Product Body -->
                            <div class="body-wrapper">
                                <!-- Title -->
                                <h4 class="product-title">
                                    <a href="/products/details/@product.Id" target="_self">
                                        @product.Name
                                    </a>
                                </h4>

                                <!-- Description -->
                                <p class="product-description">@product.Description</p>

                                <!-- Price Info -->
                                <div class="price-info">
                                    <p class="product-size">@product.Size</p>
                                    <div class="unit-pricing">
                                        <span class="product-price">@product.Price.Amount @product.Price.Currency</span>
                                        <span>/</span>
                                        <span class="unit-price">@product.Price.UnitPrice</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Call to Action -->
                            <div class="cta-wrapper">
                                <button class="add-to-cart-btn" aria-label="Add to your cart - €@product.Price.Amount">Add to your cart</button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Load More Button -->
            <div class="load-more-container">
                @* <p class="fst-italic text-center text-sm-center">About <span id="numofRemaining">
                        @(Model?.Count() > 0 ? (Model?.Count() - 6): 0)
                </span> more products remaining... load more if you want to explore.</p> *@

                <button class="load-more-btn" onclick="loadMoreProducts()">
                    <span>Load More</span>
                    <i class="bi bi-chevron-double-down"></i>
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    let currentPage = 1;
    const itemsPerPage = 3;

    async function loadMoreProducts() {
        const response = await fetch(`/Products/LoadMoreProducts`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ page: currentPage, size: itemsPerPage })
        });
        const products = await response.json();

        if (typeof products !== 'underfined' || products?.length > 0) {
            const container = document.querySelector('.product-grid');
            products.forEach(product => {
                const item = document.createElement('div');
                item.className = 'product-grid-item';
                item.innerHTML = `
                    <div class="product-grid-item">
                        <div class="image-wrapper">
                            <a href="/products/details/${product.id}" target="_self">
                                <img alt="${product.name}" loading="lazy" src="${product.image}">
                            </a>
                        </div>

                        <div class="body-wrapper">
                            <!-- Title -->
                            <h4 class="product-title">
                                <a href="/products/details/${product.id}" target="_self">
                                    ${product.name}
                                </a>
                            </h4>

                            <p class="product-description">${product.description}</p>

                            <div class="price-info">
                                <p class="product-size">${product.size}</p>
                                <div class="unit-pricing">
                                    <span class="product-price">${product.price.amount} ${product.price.currency}</span>
                                    <span>/</span>
                                    <span class="unit-price">${product.price.unitPrice}</span>
                                </div>
                            </div>
                        </div>

                        <div class="cta-wrapper">
                            <button class="add-to-cart-btn" aria-label="Add to your cart - €${product.price.amount}">Add to your cart</button>
                        </div>
                    </div>`;
                container.appendChild(item);
            });

            currentPage++;
        } else {
            $('.load-more-btn').hide();
        }
    }
</script>