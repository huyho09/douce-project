@model IEnumerable<ScentifyWebApp.Models.Dtos.DtoPerfume>?

@{
    ViewData["Title"] = $"Finding {ViewData["searchInput"]} ...";
}

<section class="podium-section">
    <div class="podium-ref-div">
        <div class="product-commerce-cards">
            <div class="card-wrapper">
                <div class="text-wrapper">
                    <header class="section-heading">
                        @* <b>A bold and unorthodox collection</b> *@
                        <h2>Tìm kiếm nước hoa @ViewData["searchInput"]...</h2>
                    </header>
                    <p class="col-md-8 col-sm-12">
                        Trải nghiệm cùng TRANSMUTÉ không đơn thuần là sự đắm chìm trong hương thơm, mà là một nghi thức hóa thân Doucé kiến tạo - nơi hương thơm không chỉ bao bọc mà còn trở thành một phần của bản thể.
                        <br />
                        <br />
                        Những sáng tạo hương TRANSMUTÉ tỏa ra, thấm sâu vào từng chuyển động, như một lớp da thứ hai, như khí chất bẩm sinh. Chúng không rời rạc mà kết tinh trong dòng chảy của chính bạn, lan tỏa mạnh mẽ nhưng liền mạch, quấn lấy thân thể như một dấu ấn vĩnh cửu của sự biến đổi.
                    </p>
                </div>
            </div>

            <div class="product-grid">
                @if (Model != null && Model?.Count() > 0)
                {
                    var filterModel = Model.Take(6);
                    foreach (var product in filterModel)
                    {
                        var priceInfoFirst = product.ProductSizes?[0];
                        var priceInfoSecond = product.ProductSizes?[1];
                        <div class="product-grid-item">
                            <!-- Image -->
                            <a href="/products/details/@product.Id" target="_self">
                                <div class="image-wrapper">
                                    <img alt="@product.Name" loading="lazy" src="@priceInfoFirst?.ImageUrl">
                                </div>
                            </a>

                            <!-- Product Body -->
                            <div class="body-wrapper">
                                <!-- Title -->
                                <h4 class="product-title">
                                    <a href="/products/details/@product.Id" target="_self">
                                        @product.Name
                                    </a>
                                </h4>

                                <!-- Description -->
                                <p class="product-description">@product.ShortDescription</p>
                                <!-- Price Info -->
                                <div class="price-info w-100">
                                    @if (priceInfoFirst != null)
                                    {
                                        <label class="radio-button active">
                                            <input type="radio" name="size" value="@priceInfoFirst.VolumeMl">
                                            <span class="radio"></span>
                                            @priceInfoFirst.VolumeMl mL
                                        </label>
                                    }

                                    @if (priceInfoSecond != null)
                                    {
                                        <label class="radio-button">
                                            <input type="radio" name="size" value="@priceInfoSecond.VolumeMl">
                                            <span class="radio"></span>
                                            @priceInfoSecond.VolumeMl mL
                                        </label>
                                    }
                                </div>
                                @if (priceInfoFirst != null)
                                {
                                    <a href="/products/details/@product.Id/@priceInfoFirst.VolumeMl" data-volume="@priceInfoFirst.VolumeMl" class="price size-button" aria-label="@priceInfoFirst.Currency @priceInfoFirst.Price - @priceInfoFirst.VolumeMl mL" data-id="@product.Id">@priceInfoFirst.Price.ToString("N0") @priceInfoFirst.Currency</a>
                                }
                                @if (priceInfoSecond != null)
                                {
                                    <a href="/products/details/@product.Id/@priceInfoSecond.VolumeMl" data-volume="@priceInfoSecond.VolumeMl" class="price size-button hide" aria-label="@priceInfoSecond.Currency @priceInfoSecond.Price - @priceInfoSecond.VolumeMl mL" data-id="@product.Id">@priceInfoSecond.Price.ToString("N0") @priceInfoSecond.Currency</a>
                                }
                            </div>

                            <!-- Call to Action -->
                            @*  <div class="cta-wrapper">
                                <button class="add-to-cart-btn" aria-label="Add to your cart - @priceInfo.Currency @priceInfo.Price" data-id="@product.Id">Add to your cart</button>
                            </div> *@
                        </div>
                    }
                }
            </div>

            <!-- Load More Button -->
            @if (Model?.Count() > 6)
            {
                <div class="load-more-container">
                    @* <p class="fst-italic text-center text-sm-center">About <span id="numofRemaining">
                @(Model?.Count() > 0 ? (Model?.Count() - 6): 0)
                </span> more products remaining... load more if you want to explore.</p> *@

                    <button class="load-more-btn" onclick="loadMoreProducts()">
                        <span>Load More</span>
                        <i class="bi bi-chevron-double-down"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<script src="~/js/jquery-1.11.0.min.js"></script>
<script>
    let currentPage = 3;
    const itemsPerPage = 3;

    async function loadMoreProducts() {
        showLoading();

        const response = await fetch(`/Products/LoadMoreProducts`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ page: currentPage, size: itemsPerPage })
        });
        const result = await response.json();
        const products = result.products;
        const isEnd = result.isEnd;

        if (typeof products !== 'underfined' || products?.length > 0) {
            const container = document.querySelector('.product-grid');
            products.forEach(product => {
                const item = document.createElement('div');
                item.className = 'product-grid-item';

                const sizeOptions = product.productSizes || [];

                // Create radio buttons
                const radioButtons = sizeOptions.map((size, index) => `
                    <label class="radio-button ${index === 0 ? 'active' : ''}">
                        <input data-volume="${size.volumeMl}" type="radio" name="size-${product.id}" value="${size.volumeMl}" ${index === 0 ? 'checked' : ''}>
                        <span class="radio"></span>
                        ${size.volumeMl} mL
                    </label>
                `).join('');

                // Create size price links (toggle visibility based on selected size)
                const sizeLinks = sizeOptions.map((size, index) => `
                    <a href="/products/details/${product.id}/${size.volumeMl}"
                       data-volume="${size.volumeMl}"
                       class="price size-button ${index === 0 ? '' : 'hide'}"
                       aria-label="${size.currency} ${size.price} - ${size.volumeMl} mL"
                       data-id="${product.id}">
                       ${size.currency} ${size.price}
                    </a>
                `).join('');

                item.innerHTML = `
                    <a href="/products/details/${product.id}" target="_self">
                        <div class="image-wrapper">
                            <img alt="${product.name}" loading="lazy" src="${sizeOptions[0]?.imageUrl}">
                        </div>
                    </a>
                    <div class="body-wrapper">
                        <h4 class="product-title">
                            <a href="/products/details/${product.id}" target="_self">
                                ${product.name}
                            </a>
                        </h4>
                        <p class="product-description">${product.shortDescription || ''}</p>
                        <div class="price-info w-100">
                            ${radioButtons}
                        </div>
                        ${sizeLinks}
                    </div>
                `;

                container.appendChild(item);

                // Optional: Add event listener to toggle price display based on selected radio
                const radios = item.querySelectorAll(`input[name="size-${product.id}"]`);
                const priceLinks = item.querySelectorAll('.size-button');

                radios.forEach(radio => {
                    radio.addEventListener('change', () => {
                        const value = $(radio).val();
                        const $wrapper = $(radio).closest('.body-wrapper');
                        const $prices = $wrapper.find('.size-button');
                        const $labels = $wrapper.find('.radio-button');

                        // Slide animation
                        $prices.each(function (index,price) {
                            const $price = $(price);
                            if ($price.attr('data-volume') === value) {
                                $price.removeClass('hide');
                            } else {
                                $price.addClass('hide');
                            }
                        });

                        // Active label update
                        $labels.removeClass('active');
                        $(radio).closest('.radio-button').addClass('active');
                    });
                });
            });

            currentPage++;

            // Hide load more button if this is the last batch
            if (isEnd) {
                document.querySelector('.load-more-btn').style.display = 'none';
            }
            hideLoading();
        } else {
            $('.load-more-btn').hide();
        }
    }
</script>