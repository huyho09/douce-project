    <header class="custom-navbar">
        <nav class="custom-nav-container">
            <!-- Left: Logo -->
            <a href="/" class="custom-logo"><img src="~/images/logo/logo-text-01.png" style="width: 90px;" /></a>

            <!-- Centered Navigation Links -->
            <ul class="custom-nav-links">
                <li><a href="/home">Trang chủ</a></li>
                <li><a href="/products">Sản phẩm</a></li>
            </ul>

            <!-- Right Side: Search & Cart Icons -->
            <div class="custom-nav-right">
                <form asp-controller="Products" asp-action="Search" method="get" class="search-group-box">
                    <button type="button" class="custom-search-btn" id="btn-search">
                        <svg class="custom-icon">
                            <use xlink:href="#custom-search"></use>
                        </svg>
                    </button>
                    <input type="text" name="searchInput" class="search-input col-sm-12" id="search-input" placeholder="Bạn tìm kiếm gì từ Douce?" />
                </form>
                <button class="custom-search-btn mobile-btn" id="btn-search-popup" type="button">
                    <svg class="custom-icon">
                        <use xlink:href="#custom-search"></use>
                    </svg>
                </button>
                <a href="javascript:void(0);" onclick="toggleCart()">
                    <svg class="custom-icon">
                        <use xlink:href="#custom-cart"></use>
                    </svg>
                    <span class="p-2 text-dark" id="number-of-cart">
                    </span>
                </a>
            </div>
        </nav>
    </header>

    <!-- Search Modal -->
    <div class="modal fade noti-modal" id="search-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                @* <button class="custom-close" id="close-search">&times;</button> *@
                <form asp-controller="Products" asp-action="Search" method="get" class="search-form">
                    <input name="searchInput" type="text" class="search-input" placeholder="Bạn tìm kiếm gì từ Douce?" />
                    <button type="submit" class="btn-glow">Search</button>
                </form>
            </div>
        </div>
    </div>

    <!--Render Body-->
    <main role="main" class="pb-3">

        <!--Render cart-->
        <div id="cart-component">
            @await Html.PartialAsync("~/Views/Cart/Index.cshtml", new List<CartItem>());
        </div>

        @RenderBody()

        <!-- Bootstrap Modal -->
        <div class="modal fade noti-modal" id="infoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    @* <button type="button" class="btn-close custom-close" data-bs-dismiss="modal"></button> *@
                    <div class="modal-body text-center">
                        <h3 class="modal-title text-light h5">Notification</h3>
                        <p class="mt-4" id="infoMessage">Processing...</p>
                        @* <button class="btn btn-glow">Claim Now</button> *@
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading Spinner (hidden by default) -->
        <div id="loadingOverlay" class="loading-overlay">
            <div class="loading-spinner">
                <div class="spinner-circle"></div>
                <span class="loading-text">Loading...</span>
            </div>
        </div>

    </main>


