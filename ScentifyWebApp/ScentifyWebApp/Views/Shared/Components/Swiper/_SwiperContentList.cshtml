@using ScentifyWebApp.Models.Dtos;
@using Newtonsoft.Json;

@model (string title, bool isMobile, List<DtoPerfume> perfumes)
@{
	List<string> perfumeImgs = new List<string>()
{
		"/images/perfume/ANGELISM.png",
		"/images/perfume/APHRODITE.png",
		"/images/perfume/FORBIDDEN-SWEET.png",
		"/images/perfume/FREQUENCE.png",
		"/images/perfume/GILDED-TOBAC.png",
		"/images/perfume/HANDS-OF-MIDAS.png"
	};
}
@if (Model.perfumes != null && Model.perfumes.Count > 0)
{
	<div class="mySwiperContainermySwiperContainer @(Model.isMobile ? "mySwiperMobileContainer" : "mySwiperContainer")">
		<div class="display-header text-uppercase text-dark text-center pb-3">
			<h2 class="display-7">@Model.title</h2>
		</div>
		<div #swiperRef="" class="swiper @(Model.isMobile ? "mySwiperMobile" : "mySwiper")">
			<div class="swiper-wrapper">
				@{
					var indexPerfume = 0;
					@foreach (var perfume in Model.perfumes.Take(6))
					{
						<div class="swiper-slide">
							<a href="/products/details/@perfume.Id" target="_self">
								<img class="img-flacon" src="@(perfumeImgs[indexPerfume])" alt="@perfume.Name" />
							</a>
						</div>
						indexPerfume++;
					}
				}
			</div>
			<div class="d-flex justify-content-center align-content-center">
				<div class="swiper-button-next"></div>
				<div class="swiper-button-prev"></div>
			</div>
		</div>

		<div class="display-header text-dark text-center pb-3">
			@{
				var index = 0;
				@foreach (var perfume in Model.perfumes.Take(6))
				{
					if (perfume.ProductSizes != null && perfume.ProductSizes.Count() > 0)
					{
						<div class="@(Model.isMobile ? $"content-mobile-{index} swiper-detail-mobile" : $"content-{index} swiper-detail") @(index == 0 ? "" : "d-none")">

							<partial name="/Views/Shared/Components/Swiper/_SwiperContentDetailI.cshtml"
									 model=@(perfume) />
						</div>
						index++;
					}
				}
			}
		</div>
	</div>
}
@functions {
	public static bool GetRandomBool()
	{
		return Random.Shared.Next(2) == 0;
	}
}