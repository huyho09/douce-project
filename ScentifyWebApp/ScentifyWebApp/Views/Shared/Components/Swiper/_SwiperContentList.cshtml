    <div class="display-header text-dark text-center pb-3">
        @{
            if (Model.perfumes != null && Model.perfumes.Count > 0)
            {
                var index = 0;
                @foreach (var perfume in Model.perfumes)
                {
                    if (perfume.DtoIngredients!= null && perfume.DtoIngredients.Count() > 0)
                    {
                        var ingredients = perfume.DtoIngredients;

                        <div class="@(Model.isMobile ? $"content-mobile-{index} swiper-detail-mobile": $"content-{index} swiper-detail") @(index == 0 ? "" :  "d-none")">
                            <partial name="/Views/Shared/Components/Swiper/_SwiperContentDetailI.cshtml"
                                     model=@( (perfume.Name,
                                             ingredients?.Select(m => m.Name).ToList() ?? new List<string>(),
                                             1,
                                             perfume.VolumeMl,
                                             $"{perfume.Currency} {perfume.Price}",
                                             perfume.UnitPrice ?? "",
                                             GetRandomBool(), GetRandomBool(), GetRandomBool(), GetRandomBool(),
                                             GetRandomBool(), GetRandomBool(), GetRandomBool(), GetRandomBool(),
                                             GetRandomBool(), GetRandomBool(), GetRandomBool(),
                                             new List<string>()) ) />
                        </div>
                        index++;
                    }
                }
            }
        }
    </div>
</div>

@functions {
    public static bool GetRandomBool()
    {
        return Random.Shared.Next(2) == 0;
    }
}