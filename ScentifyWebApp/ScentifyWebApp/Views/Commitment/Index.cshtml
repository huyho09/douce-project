@{
	ViewData["Title"] = "Commitment";
}
<section class="podium-section">
	<div class="podium-ref-div">
		<div class="product-commerce-cards">
		</div>
	</div>
</section>
<section class="third-section container podium-section contact-us">
	<div class="section-content">
		<!-- Heading -->
		<div class="section-heading">
			<h2 class="pb-4 text-uppercase commit-title">CAM KẾT & GIÁ TRỊ</h2>

			<div class="text-white commit-content-box">
				<h5>Theo đuổi sứ mệnh đem đến những sản phẩm tốt nhất cho khách hàng, DOUCÉ sử dụng tinh dầu chất lượng cao, nhập khẩu chính ngạch; cam kết tuân thủ nghiêm ngặt các tiêu chuẩn an toàn trong ngành nước hoa, đảm bảo:</h5>
				<ul>
					<li>
						Không chứa chất gây kích ứng
					</li>
					<li>
						Không chứa thành phần độc hại như chì, thuỷ ngân hay asen
					</li>
				</ul>
				<div class="d-flex flex-column align-content-center gap-1">
					<div class="row">
						<div class="col-md-6 col-sm-12 mt-3">
							<img class="w-100" src="~/images/CommitCertification2.jpg" alt="Phiếu kiểm nghiệm 2" />
						</div>
						<div class="col-md-6 col-sm-12 mt-3">
							<img class="w-100" src="~/images/CommitCertification1.jpg" alt="Phiếu kiểm nghiệm 1" />
						</div>
					</div>
				
				</div>
			</div>
		</div>
	</div>

</section>