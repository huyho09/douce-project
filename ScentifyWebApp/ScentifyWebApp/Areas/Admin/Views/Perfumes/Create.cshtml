                                <label class="form-label" for="ImageUrl">Product Image:</label>
                                <div class="upload-placeholder" id="placeholder-0" onclick="document.getElementById('file-input-0').click()">
                                    @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl" class="uploaded-image" alt="Uploaded image">
                                    }
                                    else
                                    {
                                        @Html.Raw("Upload Image")
                                    }
                                </div>
                                <input type="file" class="file-input" id="file-input-0" accept="image/*" onchange="uploadImage(0)">
                                <input type="hidden" asp-for="ImageUrl" id="image-input-0" name="ImageUrl" value="@Model?.ImageUrl" />
                            </div>
                            <hr /> *@
                            <div class="col-lg-5"></div>

                            <div class="form-outline mb-4 col-lg-12">
                                <label class="form-label" for="Name">Name:</label>
                                <input id="Name" name="Name" required class="form-control" autocomplete="off" value="@Model?.Name" />
                            </div>

                            <!-- Top Notes -->
                            <div class="form-outline mb-4 col-lg-6">
                                <label class="form-label" for="TopPerfumed">Top Notes:</label>
                                <textarea id="TopPerfumed" name="TopPerfumed" class="form-control" autocomplete="off">@Model?.TopPerfumed</textarea>
                            </div>
                            <!-- Middle Notes -->
                            <div class="form-outline mb-4 col-lg-6">
                                <label class="form-label" for="MiddlePerfumed">Middle Notes:</label>
                                <textarea id="MiddlePerfumed" name="MiddlePerfumed" class="form-control" autocomplete="off">@Model?.MiddlePerfumed</textarea>
                            </div>
                            <!-- Base Notes -->
                            <div class="form-outline mb-4 col-lg-6">
                                <label class="form-label" for="BasePerfumed">Base Notes:</label>
                                <textarea id="BasePerfumed" name="BasePerfumed" class="form-control" autocomplete="off">@Model?.BasePerfumed</textarea>
                            </div>

                            <!-- Short Description -->
                            <div class="form-outline mb-4 col-lg-6">
                                <label class="form-label" for="ShortDescription">Short Description:</label>
                                <textarea id="ShortDescription" name="ShortDescription" class="form-control">@Model?.ShortDescription</textarea>
                            </div>

                            <!-- Description -->
                            <div class="form-outline mb-4 col-lg-12">
                                <label class="form-label" for="Description">Description:</label>
                                <textarea asp-for="Description" name="Description" class="form-control" id="summernote">@Model?.Description</textarea>
                            </div>

                            <div class="form-outline mb-4 col-lg-6">
                                <div class="form-outline mb-4">
                                    <label class="form-label" for="ImageUrl1">Product Image 1:</label>
                                    <div class="upload-placeholder" id="placeholder-10" onclick="document.getElementById('file-input-10').click()">
                                        @if (!string.IsNullOrEmpty(Model?.ImageUrl1))
                                        {
                                            <img src="@Model.ImageUrl1" class="uploaded-image" alt="Uploaded image">
                                        }
                                        else
                                        {
                                            @Html.Raw("Upload Image")
                                        }
                                    </div>
                                    <input type="file" class="file-input" id="file-input-10" accept="image/*" onchange="uploadImage(10)">
                                    <input type="hidden" asp-for="ImageUrl1" id="image-input-10" name="ImageUrl1" value="@Model?.ImageUrl1" />
                                </div>

                                <!-- Volume (ml) 1 -->
                                <div class="form-outline mb-4">
                                    <label class="form-label" for="VolumeMl1">Volume 1 (ml):</label>
                                    <input id="VolumeMl1" name="VolumeMl1" type="number" class="form-control" min="0" step="0" value="@Model?.VolumeMl1" />
                                </div>

                                <!-- Price 1 -->
                                <div class="form-outline mb-4">
                                    <label class="form-label" for="Price1">Price 1 (VND):</label>
                                    <input id="Price1" name="Price1" type="number" class="form-control" step="0.01" min="0" value="@Model?.Price1" />
                                </div>
                            </div>

                            <div class="form-outline mb-4 col-lg-6">
                                <div class="form-outline mb-4">
                                    <label class="form-label" for="ImageUrl2">Product Image 2:</label>
                                    <div class="upload-placeholder" id="placeholder-11" onclick="document.getElementById('file-input-11').click()">
                                        @if (!string.IsNullOrEmpty(Model?.ImageUrl2))
                                        {
                                            <img src="@Model.ImageUrl2" class="uploaded-image" alt="Uploaded image">
                                        }
                                        else
                                        {
                                            @Html.Raw("Upload Image")
                                        }
                                    </div>
                                    <input type="file" class="file-input" id="file-input-11" accept="image/*" onchange="uploadImage(11)">
                                    <input type="hidden" asp-for="ImageUrl2" id="image-input-11" name="ImageUrl2" value="@Model?.ImageUrl2" />
                                </div>

                                <!-- Volume (ml) 2 -->
                                <div class="form-outline mb-4">
                                    <label class="form-label" for="VolumeMl2">Volume 2 (ml):</label>
                                    <input id="VolumeMl2" name="VolumeMl2" type="number" class="form-control" min="0" value="@Model?.VolumeMl2" />
                                </div>

                                <!-- Price 2 -->
                                <div class="form-outline mb-4">
                                    <label class="form-label" for="Price2">Price 2 (VND):</label>
                                    <input id="Price2" name="Price2" type="number" class="form-control" step="0.01" min="0" value="@Model?.Price2" />
                                </div>
                            </div>

                            <!-- Upload More Description Images -->
                            @* <div class="form-outline mb-4 col-lg-12">
                                <label class="form-label" for="DescriptionImageFiles">Upload More Description Images:</label>
                                <div class="input-images-2" style="padding-top: .5rem;"></div>
                            </div> *@
                            <div class="form-outline mb-4 col-lg-12">
                                <label class="form-label" for="DescriptionImageFiles">Upload More Description Images:</label>
                                <div class="input-images-2" style="padding-top: .5rem;"></div>

                                <!-- Placeholder for hidden inputs -->
                                <div id="hidden-image-fields"></div>
                            </div>

                            <!-- Ingredients -->
                            <div class="form-outline mb-4 col-sm-12 col-md-8">
                                <label>Set Ingredients: </label>
                                <div class="row">
                                    <!-- First Column -->
                                    <div class="col-md-6">
                                        <!-- First Row: Image Upload -->
                                        <div class="upload-placeholder" id="placeholder-1" onclick="document.getElementById('file-input-1').click()">
                                            @if (!string.IsNullOrEmpty(Model?.Ingredient_Img_1))
                                            {
                                                <img src="@Model.Ingredient_Img_1" class="uploaded-image" alt="Uploaded image">
                                            }
                                            else
                                            {
                                                @Html.Raw("Upload Ingredient Image")
                                            }
                                        </div>
                                        <input type="file" class="file-input" id="file-input-1" accept="image/*" onchange="uploadImage(1)">
                                        <input type="hidden" asp-for="Ingredient_Img_1" id="image-input-1" name="Ingredient_Img_1" value="@Model?.Ingredient_Img_1" />
                                        <!-- Title Input -->
                                        <input type="text" class="form-control mb-3" placeholder="Enter the first ingredient's name..." id="Ingredient_Name_1" name="Ingredient_Name_1" value="@Model?.Ingredient_Name_1">
                                        <!-- Second Row: Image Upload -->
                                        <div class="upload-placeholder" id="placeholder-3" onclick="document.getElementById('file-input-3').click()">
                                            @if (!string.IsNullOrEmpty(Model?.Ingredient_Img_3))
                                            {
                                                <img src="@Model.Ingredient_Img_3" class="uploaded-image" alt="Uploaded image">
                                            }
                                            else
                                            {
                                                @Html.Raw("Upload Ingredient Image")
                                            }
                                        </div>
                                        <input type="file" class="file-input" id="file-input-3" accept="image/*" onchange="uploadImage(3)">
                                        <input type="hidden" id="image-input-3" asp-for="Ingredient_Img_3" name="Ingredient_Img_3" value="@Model?.Ingredient_Img_3" />
                                        <!-- Title Input -->
                                        <input type="text" class="form-control mb-3" placeholder="Enter the second ingredient's name..." id="Ingredient_Name_3" name="Ingredient_Name_3" value="@Model?.Ingredient_Name_3">
                                    </div>

                                    <!-- Second Column -->
                                    <div class="col-md-6">
                                        <!-- First Row: Image Upload -->
                                        <div class="upload-placeholder" id="placeholder-2" onclick="document.getElementById('file-input-2').click()">
                                            @if (!string.IsNullOrEmpty(Model?.Ingredient_Img_2))
                                            {
                                                <img src="@Model.Ingredient_Img_2" class="uploaded-image" alt="Uploaded image">
                                            }
                                            else
                                            {
                                                @Html.Raw("Upload Ingredient Image")
                                            }
                                        </div>
                                        <input type="file" class="file-input" id="file-input-2" accept="image/*" onchange="uploadImage(2)">
                                        <input type="hidden" id="image-input-2" asp-for="Ingredient_Img_2" name="Ingredient_Img_2" value="@Model?.Ingredient_Img_2" />
                                        <!-- Title Input -->
                                        <input type="text" class="form-control mb-3" placeholder="Enter the third ingredient's name ..." id="Ingredient_Name_2" name="Ingredient_Name_2" value="@Model?.Ingredient_Name_2">
                                        <!-- Second Row: Image Upload -->
                                        <div class="upload-placeholder" id="placeholder-4" onclick="document.getElementById('file-input-4').click()">
                                            @if (!string.IsNullOrEmpty(Model?.Ingredient_Img_4))
                                            {
                                                <img src="@Model.Ingredient_Img_4" class="uploaded-image" alt="Uploaded image">
                                            }
                                            else
                                            {
                                                @Html.Raw("Upload Ingredient Image")
                                            }
                                        </div>
                                        <input type="file" class="file-input" id="file-input-4" accept="image/*" onchange="uploadImage(4)">
                                        <input type="hidden" id="image-input-4" asp-for="Ingredient_Img_4" name="Ingredient_Img_4" value="@Model?.Ingredient_Img_4" />
                                        <!-- Title Input -->
                                        <input type="text" class="form-control mb-3" placeholder="Enter the fourth ingredient's name..." id="Ingredient_Name_4" name="Ingredient_Name_4" value="@Model?.Ingredient_Name_4">
                                    </div>
                                </div>
                            </div>

                            <!-- Fragrance Notes -->
                            <div class="form-outline mb-4 col-sm-12 col-md-4">
                                <label class="mb-4">Fragrance Notes:</label><br />

                                <input type="hidden" name="Citrus" value="@(Model?.Citrus == true ? "true" : "false")" />
                                <input type="checkbox" id="Citrus" name="Citrus" value="true" @(Model?.Citrus == true ? "checked" : "") />
                                <label for="Citrus">Citrus</label><br />

                                <input type="hidden" name="Floral" value="@(Model?.Floral == true ? "true" : "false")" />
                                <input type="checkbox" id="Floral" name="Floral" value="true" @(Model?.Floral == true ? "checked" : "") />
                                <label for="Floral">Floral</label><br />

                                <input type="hidden" name="Fruity" value="@(Model?.Fruity == true ? "true" : "false")" />
                                <input type="checkbox" id="Fruity" name="Fruity" value="true" @(Model?.Fruity == true ? "checked" : "") />
                                <label for="Fruity">Fruity</label><br />

                                <input type="hidden" name="Woody" value="@(Model?.Woody == true ? "true" : "false")" />
                                <input type="checkbox" id="Woody" name="Woody" value="true" @(Model?.Woody == true ? "checked" : "") />
                                <label for="Woody">Woody</label><br />

                                <input type="hidden" name="Musky" value="@(Model?.Musky == true ? "true" : "false")" />
                                <input type="checkbox" id="Musky" name="Musky" value="true" @(Model?.Musky == true ? "checked" : "") />
                                <label for="Musky">Musky</label><br />

                                <input type="hidden" name="Oriental" value="@(Model?.Oriental == true ? "true" : "false")" />
                                <input type="checkbox" id="Oriental" name="Oriental" value="true" @(Model?.Oriental == true ? "checked" : "") />
                                <label for="Oriental">Oriental</label><br />

                                <input type="hidden" name="Spicy" value="@(Model?.Spicy == true ? "true" : "false")" />
                                <input type="checkbox" id="Spicy" name="Spicy" value="true" @(Model?.Spicy == true ? "checked" : "") />
                                <label for="Spicy">Spicy</label><br />

                                <input type="hidden" name="Tobacco" value="@(Model?.Tobacco == true ? "true" : "false")" />
                                <input type="checkbox" id="Tobacco" name="Tobacco" value="true" @(Model?.Tobacco == true ? "checked" : "") />
                                <label for="Tobacco">Tobacco</label><br />

                                <input type="hidden" name="Gourmand" value="@(Model?.Gourmand == true ? "true" : "false")" />
                                <input type="checkbox" id="Gourmand" name="Gourmand" value="true" @(Model?.Gourmand == true ? "checked" : "") />
                                <label for="Gourmand">Gourmand</label><br />
                            </div>
                        </div>
                        <div class="mt-5 text-end">
                            <button type="submit" class="btn btn-primary">Create</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@* <script src="~/admin/vendor/jquery/jquery.min.js"></script> *@
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#summernote').summernote({
                callbacks: {
                    onImageLinkInsert: function (url) {
                        // url is the image url from the dialog
                        $img = $('<img>').attr({ src: url })
                        $summernote.summernote('insertNode', $img[0]);
                    }
                },
                height: 300,
                fontNames: ['Montserrat', 'Serif', 'Open Sans', 'Sans', 'sans-serif', 'Arial', 'Arial Black', 'Comic Sans MS', 'Courier New', 'Comfortaa'],
                fontNamesIgnoreCheck: ['Montserrat', 'Serif', 'Open Sans', 'Sans', 'sans-serif', 'Comfortaa']
            });

            // summernote.image.link.insert
            $('#summernote').on('summernote.image.link.insert', function (we, url) {
                // url is the image url from the dialog
                $img = $('<img>').attr({ src: url })
                $summernote.summernote('insertNode', $img[0]);
            });

             // Select all checkboxes in the Fragrance Notes section
            const checkboxes = document.querySelectorAll('.form-outline input[type="checkbox"]');

            // Add an event listener to each checkbox
            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    // Get the name of the checkbox (e.g., "Citrus" from id="Citrus")
                    const checkboxName = this.id;

                    // Find the corresponding hidden input with the same name (e.g., name="Citrus")
                    const hiddenInput = document.querySelector(`input[type="hidden"][name="${checkboxName}"]`);

                    // Update the hidden input's value based on checkbox state
                    if (hiddenInput) {
                        hiddenInput.value = this.checked ? 'true' : 'false';
                    }
                });

                // Trigger the change event on page load to set initial values
                checkbox.dispatchEvent(new Event('change'));
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            const base64Images = @Html.Raw(Json.Serialize(Model?.ListDescriptionImages));
            let preloaded;
            if(base64Images?.length > 0){
                preloaded = base64Images.map((src, index) => ({
                    id: index + 1,
                    src: src
                }));
            }
            const maxFiles = 6;

            $('.input-images-2').imageUploader({
                preloaded: preloaded,
                imagesInputName: 'DescriptionImageFiles',
                extensions: ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.tiff', '.svg'],
                maxSize: 2 * 1024 * 1024,
                maxFiles: maxFiles,
                preloadedInputName: 'DescriptionImageFiles',
                // optional: preloaded logic if editing
            });
        });
    </script>
}