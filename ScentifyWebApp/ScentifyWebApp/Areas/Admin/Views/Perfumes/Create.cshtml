@{
    ViewData["Title"] = "Create Perfume";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .modal-content {
        color: black !important;
    }
</style>
@model ScentifyWebApp.Models.Dtos.DtoPerfume
<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-12 col-md-7">
        <div class="card o-hidden border-0 shadow-lg my-lg-5">
            <div class="card-body p-0 card-login">
                <div class="text-center">
                    <h1 class="h3 text-gray-900 mb-4 mt-5 font-weight-bold">CREATE CATEGORY ITEM</h1>
                </div>
                <div class="h-full overflow-hidden m-4">
                    <form asp-area="Admin" asp-action="Create" asp-controller="Perfumes" method="post" enctype="multipart/form-data">
                        @if (!string.IsNullOrEmpty(ViewData["ErrorSubmit"]?.ToString()))
                        {
                            <p class="text-danger">@ViewData["ErrorSubmit"]</p>
                        }
                        <div class="row">
                            <!-- Image Upload -->
