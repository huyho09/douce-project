</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#summernote').summernote({
                callbacks: {
                    onImageLinkInsert: function (url) {
                        // url is the image url from the dialog
                        $img = $('<img>').attr({ src: url })
                        $summernote.summernote('insertNode', $img[0]);
                    }
                },
                height: 300,
                fontNames: ['Montserrat', 'Serif', 'Open Sans', 'Sans', 'sans-serif', 'Arial', 'Arial Black', 'Comic Sans MS', 'Courier New', 'Comfortaa'],
                fontNamesIgnoreCheck: ['Montserrat', 'Serif', 'Open Sans', 'Sans', 'sans-serif', 'Comfortaa']
            });

            // summernote.image.link.insert
            $('#summernote').on('summernote.image.link.insert', function (we, url) {
                // url is the image url from the dialog
                $img = $('<img>').attr({ src: url })
                $summernote.summernote('insertNode', $img[0]);
            });

        });
    </script>
    <script>
        $(document).ready(function () {
            const base64Images = @Html.Raw(Json.Serialize(descriptionImages));
            let preloaded;
            if(base64Images?.length > 0){
                preloaded = base64Images.map((src, index) => ({
                    id: index + 1,
                    src: src
                }));
            }
            const maxFiles = 6;

            $('.input-images-2').imageUploader({
                preloaded: preloaded,
                imagesInputName: 'DescriptionImageFiles',
                extensions: ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.tiff', '.svg'],
                maxSize: 2 * 1024 * 1024,
                maxFiles: maxFiles,
                preloadedInputName: 'DescriptionImageFiles',
                // optional: preloaded logic if editing
            });


            $(() => {

            $('form').on('submit', function (e) {
                e.preventDefault();

                const $form = $(this);

                var jsonImages = JSON.stringify(getFormatBase64Values($('.input-images-2 .uploaded-image img')));
                if (jsonImages) {
                    $('[name="DescriptionImages"]').val(jsonImages);
                }

                const data = $form.serialize(); // URL-encoded string

                // Example: add custom field
                const finalData = data;

                $.ajax({
                    url: $form.attr('action'),
                    method: $form.attr('method') || 'POST',
                    data: finalData,
                    success: function (response) {
                        console.log('Response:', response);
                        alert("Successful");
                        $('html, body').animate({
                            scrollTop: $('[role="main"]').offset().top
                        }, 500); // 500ms animation duration
                        location.reload();
                    },
                    error: function (xhr, status, error) {
                        console.error('Error:', error);
                    }
                });
            });
        });
        });
    </script>
}